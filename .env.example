# --- Public media origin ---
# The R2 bucket holding all media. The browser never calls this directly: media is
# proxied through the app's own /media path (see next.config.ts), because some
# school and corporate networks block *.r2.dev outright. Serving same-origin also
# avoids CORS for the Web Audio visualiser and the decoded ambience buffers.
#
# Only override this if you move the bucket or map a custom domain to it.
# Include the bucket prefix, with no trailing slash.
# NEXT_PUBLIC_R2_URL=https://cdn.your-domain.com/lofi-station

# --- Cloudflare R2 (server-side credentials, admin writes only) ---
# Used solely by /api/upload and the admin's manifest save. Never sent to the browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=markc-assets

# --- Admin console ---
# Password for /admin. Also derives the key used to sign admin session cookies,
# so there is nothing else to configure. Changing it signs out existing sessions.
ADMIN_PASSWORD=

# --- Bucket CORS ---
# Not needed while media is proxied same-origin, but keep it configured so direct
# bucket access still works if the proxy is ever removed:
# [
#   {
#     "AllowedOrigins": ["https://lofiweb.vercel.app", "http://localhost:3000"],
#     "AllowedMethods": ["GET", "HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": ["Content-Length", "Content-Range"],
#     "MaxAgeSeconds": 3000
#   }
# ]
