# --- Cloudflare R2 (server-side credentials) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=markc-assets

# Public origin used to build URLs returned by /api/upload.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Admin console ---
# Password for /admin. Also derives the key used to sign admin session cookies,
# so there is nothing else to configure. Changing it signs out existing sessions.
ADMIN_PASSWORD=

# --- Optional ---
# Overrides the public media origin proxied by the /media rewrite.
# For production, prefer a custom domain mapped to your R2 bucket via Cloudflare CDN.
# This avoids rate limits on the direct .r2.dev URL and improves performance.
# NEXT_PUBLIC_R2_URL=https://your-custom-cdn-domain.com/lofi-station

# Example CORS policy for R2:
# [
#   {
#     "AllowedOrigins": ["https://your-vercel-domain.vercel.app"],
#     "AllowedMethods": ["GET", "HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": [],
#     "MaxAgeSeconds": 3000
#   }
# ]
