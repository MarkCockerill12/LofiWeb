# --- Public media origin (client-visible) ---
# Every media file AND the station manifest are fetched by the browser directly
# from here, so none of that traffic passes through the app host.
#
# Strongly prefer a custom domain mapped to the R2 bucket via Cloudflare:
#   - avoids networks that block *.r2.dev outright
#   - avoids rate limits on the direct r2.dev URL
#   - lets you set the CORS headers this app needs
# Include the bucket prefix, with no trailing slash.
NEXT_PUBLIC_R2_URL=https://cdn.your-domain.com/lofi-station

# REQUIRED CORS policy on the bucket. The audio visualiser reads track data via the
# Web Audio API (crossOrigin="anonymous") and ambience is decoded from fetched
# buffers — both fail without these headers.
# [
#   {
#     "AllowedOrigins": ["https://your-vercel-domain.vercel.app", "http://localhost:3000"],
#     "AllowedMethods": ["GET", "HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": ["Content-Length", "Content-Range"],
#     "MaxAgeSeconds": 3000
#   }
# ]

# --- Cloudflare R2 (server-side credentials, admin writes only) ---
# Used solely by /api/upload and the admin's manifest save. Never sent to the browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=markc-assets

# --- Admin console ---
# Password for /admin. Also derives the key used to sign admin session cookies,
# so there is nothing else to configure. Changing it signs out existing sessions.
ADMIN_PASSWORD=
